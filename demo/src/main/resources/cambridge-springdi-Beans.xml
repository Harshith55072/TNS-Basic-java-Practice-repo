<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

       <bean id="engine" class="org.tnsif.acc.c2tc.cambridge_springdi.Engine"/>
       <bean id="car" class="org.tnsif.acc.c2tc.cambridge_springdi.Car">
       <constructor-arg ref="engine"/>
       <!-- constructor-based dependency injection: Spring passes the
            "engine" bean into Car's constructor when creating "car" -->
       </bean>

</beans>
